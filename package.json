{
  "name": "gift-exchange",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4332",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "check": "wrangler types && astro check",
    "test": "node --experimental-strip-types --no-warnings scripts/test-draw.ts",
    "test:removal": "node scripts/test-removal.mjs",
    "astro": "astro",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply gift-exchange --local",
    "db:migrate": "wrangler d1 migrations apply gift-exchange --remote",
    "db:seed:local": "wrangler d1 execute gift-exchange --local --file scripts/dev-seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "wrangler": "4.141.0"
  }
}
