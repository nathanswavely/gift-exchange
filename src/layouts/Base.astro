---
import '../styles/global.css';
import Shell from '@swavely-lol/kit/Shell.astro';
import { getEnv, u } from '../lib/env';

/**
 * The Hub's own shell, from the kit (swavely-lol ADR-0004), so the Tool feels like a page
 * of it: the way home to swavely.lol with "/ gifts" beside it, and the cog menu with who
 * is signed in, the theme and sign out (which is the Hub's).
 */
interface Props { title: string }
const { title } = Astro.props;
const env = getEnv();
---

<Shell title={title} hub={env.HUB_ORIGIN ?? ''} tool={{ label: 'gifts', href: u('/') }}>
  <slot />
</Shell>
