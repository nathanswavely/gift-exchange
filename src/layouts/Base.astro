---
import '../styles/global.css';
import { getEnv, hubUrl, u } from '../lib/env';

/**
 * The same shell as the Hub's, so the Tool feels like a page of it: the mark back to
 * swavely.lol, who is signed in, the theme button, sign out (which is the Hub's).
 */
interface Props { title: string }
const { title } = Astro.props;
const env = getEnv();
const viewer = Astro.locals.viewer;
---

<!doctype html>
<html lang="en" data-theme="light" data-finish="textile">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={hubUrl(env, '/favicon/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={hubUrl(env, '/favicon/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={hubUrl(env, '/favicon/apple-touch-icon.png')} />
    <title>{`${title} · swavely.lol`}</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('lt-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="bar">
        <span class="brand">
          <a class="brand" href={hubUrl(env, '/')}><img src={hubUrl(env, '/favicon/android-chrome-192x192.png')} alt="" width="26" height="26" />swavely.lol</a>
          <a class="tool" href={u('/')}>/ gifts</a>
        </span>
        <div class="who">
          {viewer && <span class="name">{viewer.name}</span>}
          <button type="button" class="lt-btn lt-btn-ghost lt-btn-sm" id="theme" aria-label="Switch light or dark">◐</button>
          <form method="post" action={hubUrl(env, '/logout')}>
            <button class="lt-btn lt-btn-ghost lt-btn-sm" type="submit">Sign out</button>
          </form>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">swavely.lol · gift exchange</footer>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme');
        if (!b) return;
        b.addEventListener('click', function () {
          var root = document.documentElement;
          var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', t);
          try { localStorage.setItem('lt-theme', t); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
