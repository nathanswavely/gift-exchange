// The gift exchange Tool at swavely.lol/gifts (swavely-lol ADR-0001).
//
// An Astro server build on a Cloudflare Worker. Its route is more specific than the
// Hub's swavely.lol/*, so Cloudflare sends /gifts and everything under it here. Who is
// signed in comes from the Hub over the HUB service binding (its HubApi entrypoint);
// the Hub also sends every email. Deploy the Hub first: this binding names it.
//
// No secrets of its own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-exchange",
  // The main Cloudflare account, which holds the swavely.lol zone.
  "account_id": "98521ca2e365abe021315e836c0a31ed",
  // The adapter's own entrypoint plus a scheduled handler (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "swavely.lol/gifts*", "zone_name": "swavely.lol" }
  ],

  "observability": { "enabled": true },

  // Hourly: remove whoever the Hub has removed since the last run (swavely-lol
  // ADR-0003). Locally, GET /cdn-cgi/handler/scheduled runs it once.
  "triggers": { "crons": ["17 * * * *"] },

  "services": [
    { "binding": "HUB", "service": "swavely-lol", "entrypoint": "HubApi" }
  ],

  // Groups, Exchanges, Pairings, Wish lists (migrations/). Created 2026-10-19 in the
  // main account; locally the Vite plugin provides one under .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-exchange",
      "database_id": "226cb941-4982-4b0a-86a5-7673679488c7",
      "migrations_dir": "migrations"
    }
  ]
}
